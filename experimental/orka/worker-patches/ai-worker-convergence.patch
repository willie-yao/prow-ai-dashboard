diff --git a/workers/ai/main.go b/workers/ai/main.go
index 47bc4ca..cff0a1b 100644
--- a/workers/ai/main.go
+++ b/workers/ai/main.go
@@ -929,9 +929,9 @@ func executeAgentLoopWithEvents(
 	}
 
 	coordinationEnv := workerenv.ParseCoordinationEnv(os.Getenv)
-	maxIterations := 10
+	maxIterations := 80 // spike: raised for deep CI analysis (open-weight models converge slower)
 	if coordinationEnv.Enabled {
-		maxIterations = 50
+		maxIterations = 80
 	}
 	if coordinationEnv.AutonomousMode {
 		maxIterations = 100
@@ -955,6 +955,18 @@ func executeAgentLoopWithEvents(
 			MaxTokens:    4096,
 			Tools:        llmTools,
 		}
+		// Forced finalization: reserve the last few iterations for a tools-free
+		// answer so a model that keeps investigating still emits a final result
+		// instead of exhausting the budget with no answer. Dropping the tools and
+		// demanding the final answer guarantees a no-tool-call response, which the
+		// loop treats as completion.
+		if iteration >= maxIterations-2 {
+			req.Tools = nil
+			req.Messages = append(append([]llm.Message{}, messages...), llm.Message{
+				Role:    "user",
+				Content: "You have reached your investigation budget. Do NOT call any more tools. Using ONLY the evidence you have already gathered, output your FINAL answer now as the required JSON object and nothing else.",
+			})
+		}
 		common.RecordEventWithTimeout(eventRecorder, events.ExecutionEventTypeModelRequestStarted, modelLoopEventTimeout,
 			common.WithEventSummary("model request started"),
 			common.WithEventContent(eventContent(map[string]any{
@@ -1026,8 +1038,19 @@ func executeAgentLoopWithEvents(
 			common.WithEventContentText(resp.Content),
 		)
 
-		// If no tool calls, we're done
+		// If no tool calls, we're done - unless the model returned an EMPTY final
+		// message (no tool calls, no content), a small-model failure mode that
+		// otherwise submits an empty result. Re-prompt for the final answer once
+		// instead of accepting nothing.
 		if len(resp.ToolCalls) == 0 {
+			if strings.TrimSpace(resp.Content) == "" && iteration < maxIterations-1 {
+				messages = append(messages,
+					llm.Message{Role: "assistant", Content: resp.Content},
+					llm.Message{Role: "user", Content: "Your last response was empty. Do NOT call any tools. Output your FINAL answer now as the required JSON object and nothing else, using the evidence you have already gathered."},
+				)
+				stepSpan.End()
+				continue
+			}
 			stepSpan.End()
 			return resp.Content, nil
 		}
